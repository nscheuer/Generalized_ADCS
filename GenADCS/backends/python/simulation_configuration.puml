@startuml
title GenADCS simulation configuration
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty methods

package "GenADCS.backends.python.config" {
  class SimulationConfig {
    satellite: Satellite
    environment: Environment
    state: State
    state_record: structured NumPy array
    julian_date: float
    propagator: Propagator
    solver: Solver
    backend: Python | C | Rust | JAX
  }

  class DynamicsConfig {
    drag_torque: bool
    srp_torque: bool
    residual_dipole_torque: bool
    gravity_gradient_torque: bool
    drag_force: bool
    srp_force: bool
    j2_force: bool
    j3_force: bool
    j4_force: bool
    j5_force: bool
    j6_force: bool
    third_body_forces: bool
  }
}

package "GenADCS.backends.python.hardware" {
  class Satellite {
    geometry: SatelliteGeometry
    adcs: ADCSSubsystem
    state_machine: StateMachine
  }
  class StateMachine <<stub>>

  package "satellite_geometry" {
    class SatelliteGeometry {
      mass
      inertia
      center_of_mass
      panels: list[SatellitePanel]
    }
    class SatellitePanel {
      position
      orientation
      dimensions
      eta_s
      eta_d
      eta_a
      cd
    }
  }

  package "ADCS_subsystem" {
    class ADCSSubsystem {
      reaction_wheels: list[ReactionWheel]
      magnetorquers: list[Magnetorquer]
    }
    class ReactionWheel {
      position
      orientation
      misalignment
      rotational_inertia
      max_torque
      max_momentum
      effects: ordered list[Noise | Bias]
    }
    class Magnetorquer {
      position
      orientation
      misalignment
      max_dipole
      effects: ordered list[Noise | Bias]
    }
  }
}

package "GenADCS.backends.python.noise" {
  abstract class Noise
  class GaussianWhiteNoise
  class UniformNoise
  class GaussMarkovNoise
  class FlickerNoise
  class QuantizationNoise
}

package "GenADCS.backends.python.bias" {
  abstract class Bias
  class FixedBias
  class RandomWalkBias
  class LinearDrift
  class ScaleFactorError
}

package "GenADCS.backends.python.environment" {
  class Environment {
    planetary_body: PlanetaryBody
    atmosphere: AtmosphericModel
    magnetic_field: MagneticFieldModel
    j_gravity: JGravityModel
    ephemeris: EphemerisModel
  }

  package "planetary_body" {
    abstract class PlanetaryBody
    class Earth
  }
  package "atmosphere" {
    abstract class AtmosphericModel
    class NRLMSISE00
  }
  package "magnetic_field_model" {
    abstract class MagneticFieldModel
    class WMM
    class IGRF14
    class CHAOS8
  }
  package "gravity" {
    class JGravityModel {
      degrees: tuple[2, 3, 4, 5, 6]
    }
    class J2
    class J3
    class J4
    class J5
    class J6
  }
  package "ephemeris" {
    abstract class EphemerisModel
    class DE421
  }
}

package "GenADCS.backends.python.state" {
  class State <<input/output only>> {
    attitude: AttitudeState
    orbit: OrbitalState
    internal: InternalState
    to_record()
    from_record()
  }
  class AttitudeState <<input/output only>> {
    orientation
    rates
  }
  class OrbitalState <<input/output only>> {
    position | keplerian_elements
    velocity
    julian_date
  }
  class InternalState <<input/output only>> {
    wheel_momentum
  }
}

class "NumPy state record" as StateRecord <<structured array>> {
  quaternion: float64[4]
  rates: float64[3]
  position: float64[3]
  velocity: float64[3]
  momentum: float64[number_of_wheels]
}

package "GenADCS.backends.python.helpers.math" {
  class DCM <<input/output only>> {
    matrix: 3x3
    frame: q_B_from_I
    active rotation
  }
  class Quaternion {
    internal storage: scalar-first Hamilton
    frame: q_B_from_I
    convention input/output: Hamilton | JPL
    active rotation
  }
  class Rodriguez_Parameters <<input/output only>> {
    parameters: 3-vector
    singular at 180 degrees
  }
  class Modified_Rodriguez_Parameters <<input/output only>> {
    parameters: 3-vector
    automatic shadow-set switching
  }
  class QuaternionAlgebra <<numba.njit kernels>>
  class Rotations <<numba.njit kernels>>
  class FrameTransforms <<numba.njit kernels>>
  class QuaternionDerivatives <<numba.njit kernels>>
  class RigidBodyDynamics <<numba.njit kernels>>
  class VectorOperations <<numba.njit kernels>>
  class QuaternionInterpolation <<numba.njit kernels>>
}

package "GenADCS.backends.python.propagation" {
  class Propagator {
    attitude | orbital | coupled
  }
  class CoupledRK4Propagator {
    dt
  }
  class CoupledDOP853Propagator {
    dt
    rtol
    atol
  }
  abstract class KeplerianOrbitalPropagator <<stub>> {
    dt
  }
  abstract class SGP4OrbitalPropagator <<stub>> {
    dt
    tle
  }
  abstract class RK4AttitudePropagator <<stub>> {
    dt
  }
  abstract class AdaptiveRK45AttitudePropagator <<stub>> {
    dt
    rtol
    atol
  }
}

package "GenADCS.backends.python.solver" {
  class Solver {
    dynamics: DynamicsConfig
    orbital: OrbitalSolver | null
    attitude: AttitudeSolver | null
    coupled: CoupledSolver | null
  }
  class OrbitalSolver {
    propagator: KeplerianOrbitalPropagator | SGP4OrbitalPropagator
    dt
  }
  class AttitudeSolver {
    propagator: RK4AttitudePropagator | AdaptiveRK45AttitudePropagator
    dt
  }
  class CoupledSolver {
    propagator: CoupledRK4Propagator | CoupledDOP853Propagator
    dt
  }
}

class "simulate(satellite, environment, dynamics, state, solver, backend)" as simulate

SimulationConfig *-- Satellite
SimulationConfig *-- Environment
SimulationConfig *-- State
SimulationConfig *-- StateRecord
State *-- AttitudeState
State *-- OrbitalState
State *-- InternalState
State ..> StateRecord : converts at boundary
SimulationConfig *-- Propagator
SimulationConfig *-- Solver
Solver *-- DynamicsConfig
Solver o-- OrbitalSolver : split mode
Solver o-- AttitudeSolver : split mode
Solver o-- CoupledSolver : coupled mode
Propagator o-- CoupledRK4Propagator : coupled mode
Propagator o-- CoupledDOP853Propagator : coupled mode
Propagator o-- KeplerianOrbitalPropagator
Propagator o-- SGP4OrbitalPropagator
Propagator o-- RK4AttitudePropagator
Propagator o-- AdaptiveRK45AttitudePropagator
OrbitalSolver --> KeplerianOrbitalPropagator
OrbitalSolver --> SGP4OrbitalPropagator
AttitudeSolver --> RK4AttitudePropagator
AttitudeSolver --> AdaptiveRK45AttitudePropagator
CoupledSolver --> CoupledRK4Propagator
CoupledSolver --> CoupledDOP853Propagator
simulate ..> Satellite
simulate ..> Environment
simulate ..> DynamicsConfig
simulate ..> State
simulate ..> CoupledSolver

Satellite *-- SatelliteGeometry
Satellite *-- ADCSSubsystem
Satellite *-- StateMachine
SatelliteGeometry *-- "0..*" SatellitePanel
ADCSSubsystem *-- "0..*" ReactionWheel
ADCSSubsystem *-- "0..*" Magnetorquer
ReactionWheel o-- "0..* ordered" Noise : effects
ReactionWheel o-- "0..* ordered" Bias : effects
Magnetorquer o-- "0..* ordered" Noise : effects
Magnetorquer o-- "0..* ordered" Bias : effects
note right of Noise
  Actuator effects are stored in one ordered list.
  Noise and bias operations follow that list order.
end note

Noise <|-- GaussianWhiteNoise
Noise <|-- UniformNoise
Noise <|-- GaussMarkovNoise
Noise <|-- FlickerNoise
Noise <|-- QuantizationNoise
Bias <|-- FixedBias
Bias <|-- RandomWalkBias
Bias <|-- LinearDrift
Bias <|-- ScaleFactorError

Environment *-- PlanetaryBody
Environment o-- AtmosphericModel
Environment o-- MagneticFieldModel
Environment o-- JGravityModel
Environment o-- EphemerisModel
PlanetaryBody <|-- Earth
AtmosphericModel <|-- NRLMSISE00
MagneticFieldModel <|-- WMM
MagneticFieldModel <|-- IGRF14
MagneticFieldModel <|-- CHAOS8
JGravityModel <|-- J2
JGravityModel <|-- J3
JGravityModel <|-- J4
JGravityModel <|-- J5
JGravityModel <|-- J6
EphemerisModel <|-- DE421


Quaternion ..> QuaternionAlgebra
Quaternion ..> Rotations
Quaternion ..> FrameTransforms
QuaternionDerivatives ..> Quaternion
DCM ..> Quaternion : converts at API boundary
Rodriguez_Parameters ..> Quaternion : converts at API boundary
Modified_Rodriguez_Parameters ..> Quaternion : converts at API boundary

DynamicsConfig ..> Environment : selected force models
DynamicsConfig ..> SatelliteGeometry : panel force/torque models

note bottom of SimulationConfig
  Configure one propagator path:
  coupled solver, or separate orbital and attitude solvers.
  The backend is currently a configuration stub.
end note

note bottom of simulate
  Entry point currently raises NotImplementedError.
  Propagation and model calls are configuration stubs.
end note
@enduml
