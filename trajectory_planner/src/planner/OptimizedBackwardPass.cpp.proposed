// STEP 4: Optimized forward pass (generateTrajectory)
// =============================================================================

/*
Key optimizations for generateTrajectory:

1. Pre-extract all column data before the loop (same pattern as backward pass)

2. Avoid quaternion error recomputation - cache intermediate results:

// Before loop
std::vector<vec4> q_ref(N);  // Reference quaternions from Xset
for(int k = 0; k < N; k++) {
    q_ref[k] = Xset.col(k).rows(3, 6);
}

// In loop - use cached reference
const vec4& qk_ref = q_ref[k-1];

3. Simplify the quaternion error computation by pre-computing mode-specific operations
   outside the loop (the switch on quaternionTo3VecMode doesn't change during rollout)

4. Use in-place operations where possible:
   newUprev = Uset.col(k-1);  // Copy
   newUprev += Kset.slice(k-1) * join_cols(avErr, angErr, otherErr);  // In-place add
   newUprev += alpha * dset.col(k-1);  // In-place add
*/


// =============================================================================
// STEP 5: Skip inactive constraints optimization
// =============================================================================

/*
Add this before computing constraint Jacobians in backward pass:

// Quick check - are any constraints near active?
ck = sat.getConstraints(k, N, uk, xk, sunk);
const double constraint_margin = 0.05;  // Tune based on typical constraint values
bool any_near_active = false;
for(int i = 0; i < nc && !any_near_active; i++) {
    if(ck(i) > -constraint_margin) {
        any_near_active = true;
    }
}

if(any_near_active) {
    // Full computation
    cnstrJac = sat.constraintJacobians(k, N, uk, xk, sunk);
    cku = get<0>(cnstrJac);
    ckx = get<1>(cnstrJac);
    Imuk = sat.getImu(mu, mu_cols[k], ck, lam_cols[k]);
    Ilamk = sat.getIlam(mu, mu_cols[k], ck, lam_cols[k]);
    viol = Ilamk * lam_cols[k] + Imuk * ck;
} else {
    // Skip - constraints are far from active
    cku.zeros();
    ckx.zeros();
    viol.zeros();
    // Imuk, Ilamk not needed
}
*/


