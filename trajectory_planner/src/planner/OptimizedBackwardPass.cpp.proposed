// =============================================================================
// STEP 2: Add to GeneralUtil.hpp - Inlined quaternion/rotation helpers
// =============================================================================

/*
// Force inline for hot-path functions

#ifdef __GNUC__
#define FORCE_INLINE __attribute__((always_inline)) inline
#elif defined(_MSC_VER)
#define FORCE_INLINE __forceinline
#else
#define FORCE_INLINE inline
#endif

// Inlined skew-symmetric matrix (called ~30k times per trajectory)
FORCE_INLINE arma::mat33 skewSymmetric_fast(const arma::vec3& v) {
    return arma::mat33({
        {0.0,   -v(2),  v(1)},
        {v(2),   0.0,  -v(0)},
        {-v(1),  v(0),  0.0}
    });
}

// Inlined rotation matrix from quaternion (called ~25k times)
FORCE_INLINE arma::mat33 rotMat_fast(const arma::vec4& q) {
    const double q0 = q(0), q1 = q(1), q2 = q(2), q3 = q(3);
    const double q0q0 = q0*q0, q1q1 = q1*q1, q2q2 = q2*q2, q3q3 = q3*q3;
    const double q0q1 = q0*q1, q0q2 = q0*q2, q0q3 = q0*q3;
    const double q1q2 = q1*q2, q1q3 = q1*q3, q2q3 = q2*q3;
    
    return arma::mat33({
        {q0q0+q1q1-q2q2-q3q3, 2.0*(q1q2-q0q3),     2.0*(q1q3+q0q2)},
        {2.0*(q1q2+q0q3),     q0q0-q1q1+q2q2-q3q3, 2.0*(q2q3-q0q1)},
        {2.0*(q1q3-q0q2),     2.0*(q2q3+q0q1),     q0q0-q1q1-q2q2+q3q3}
    });
}

// Inlined W matrix for quaternion kinematics (called ~50k times)
FORCE_INLINE arma::mat44::fixed<4,3> findWMat_fast(const arma::vec4& q) {
    return arma::mat({
        {-q(1), -q(2), -q(3)},
        { q(0), -q(3),  q(2)},
        { q(3),  q(0), -q(1)},
        {-q(2),  q(1),  q(0)}
    });
}
*/


// =============================================================================
// STEP 3: Optimized backward pass loop structure
// =============================================================================

/*
Replace the backward pass while loop in OldPlanner::backwardPass() with this pattern:

std::tuple<BACKWARD_PASS_RESULTS_FORM, REG_PAIR> OldPlanner::backwardPass_optimized(
    double dt0, TRAJECTORY_FORM traj, VECTOR_INFO_FORM &vecs,
    AUGLAG_INFO_FORM auglag_vals, REG_PAIR regs, 
    COST_SETTINGS_FORM *costSettings_tmp, REG_SETTINGS_FORM regSettings_tmp, bool useDist)
{
    // --- OPTIMIZATION 1: Extract all data from tuples ONCE at start ---
    const mat& Xset = get<0>(traj);
    const mat& Uset = get<1>(traj);
    const int N = Xset.n_cols;
    
    const mat& Rset = get<1>(vecs);
    const mat& Vset = get<2>(vecs);
    const mat& Bset = get<3>(vecs);
    const mat& sunset = get<4>(vecs);
    const mat& satvec = get<5>(vecs);
    const mat& ECIvec = get<6>(vecs);
    const vec& pset = get<7>(vecs);
    const vec& rhoset = get<8>(vecs);
    
    const mat& lambdaSet = get<0>(auglag_vals);
    const double mu = get<1>(auglag_vals);
    const mat& muSet = get<2>(auglag_vals);
    
    // --- OPTIMIZATION 2: Pre-allocate ALL workspace matrices ---
    const int nx = sat.reduced_state_N();
    const int nu = sat.control_N();
    const int nc = sat.constraint_N();
    const int ns = sat.state_N();
    
    // Result storage
    cube Kset(nu, nx, N-1, arma::fill::zeros);
    mat dset(nu, N-1, arma::fill::zeros);
    vec2 delV(arma::fill::zeros);
    
    // Workspace - allocated once, reused every iteration
    mat Aqk(nx, nx), Bqk(nx, nu);
    mat Pk(nx, nx, arma::fill::zeros), Pk_new(nx, nx);
    vec pk(nx, arma::fill::zeros), pk_new(nx);
    mat Qkxx(nx, nx), Qkux(nu, nx), Qkuu(nu, nu), Qkuureg(nu, nu), Qkuureg_chol(nu, nu);
    vec Qkx(nx), Qku(nu);
    mat Kk(nu, nx);
    vec dk(nu);
    
    // Constraint workspace
    vec ck(nc);
    mat cku(nc, nu), ckx(nc, nx);
    mat Imuk(nc, nc), Ilamk(nc, nc);
    vec viol(nc);
    
    // Jacobian workspace
    mat Gk(nx, ns), Gkp1(nx, ns);
    
    // Intermediate products (computed once, used multiple times)
    mat PkAqk(nx, nx), BqkT_Pk(nu, nx), ImukCkx(nc, nx);
    
    // --- OPTIMIZATION 3: Pre-extract column data for entire trajectory ---
    // Avoids repeated .col(k) calls inside loop
    std::vector<vec3> B_cols(N), R_cols(N), V_cols(N), S_cols(N), sat_cols(N);
    std::vector<vec> eci_cols(N), u_cols(N), x_cols(N), lam_cols(N), mu_cols(N);
    
    for(int k = 0; k < N; k++) {
        B_cols[k] = Bset.col(k);
        R_cols[k] = Rset.col(k);
        V_cols[k] = Vset.col(k);
        S_cols[k] = sunset.col(k);
        sat_cols[k] = satvec.col(k);
        eci_cols[k] = ECIvec.col(k);
        u_cols[k] = Uset.col(k);
        x_cols[k] = Xset.col(k);
        lam_cols[k] = lambdaSet.col(k);
        mu_cols[k] = muSet.col(k);
    }
    
    // --- OPTIMIZATION 4: Pre-compute rotation matrices and G matrices ---
    // These are reused multiple times per timestep
    std::vector<mat33> Rmat_cache(N);
    std::vector<mat33> RmatT_cache(N);
    std::vector<mat> Wmat_cache(N);  // 4x3 matrices
    std::vector<mat> Gmat_cache(N);
    
    for(int k = 0; k < N; k++) {
        vec4 qk = x_cols[k].rows(3, 6);
        qk = arma::normalise(qk);  // Ensure normalized
        Rmat_cache[k] = rotMat(qk);
        RmatT_cache[k] = Rmat_cache[k].t();
        Wmat_cache[k] = findWMat(qk);
        Gmat_cache[k] = sat.findGMat(qk);
    }
    
    // --- MAIN LOOP (now with minimal allocations) ---
    double rho_reg = get<0>(regs);
    bool reset = false;
    
    for(int k = N-1; k >= 0; k--) {
        // Use pre-extracted data
        const vec& xk = x_cols[k];
        const vec& uk = u_cols[k];
        const vec3& Bk = B_cols[k];
        const vec3& Rk = R_cols[k];
        const vec3& sunk = arma::normalise(S_cols[k]);
        const vec& ek = eci_cols[k];
        const mat33& RkT = RmatT_cache[k];
        const mat& Gk_cached = Gmat_cache[k];
        
        // Get ukp (previous control)
        const vec& ukp = (k > 0) ? u_cols[k-1] : u_cols[0];
        
        // --- Dynamics Jacobians (only for k < N-1) ---
        Aqk.zeros();
        Bqk.zeros();
        
        if(k < N-1) {
            const mat& Gkp1_cached = Gmat_cache[k+1];
            
            // Build dynamics info (could use struct instead of tuple)
            DYNAMICS_INFO_FORM dyn_k = std::make_tuple(
                Bk, Rk, pset(k), V_cols[k], S_cols[k], int(useDist), rhoset(k));
            DYNAMICS_INFO_FORM dyn_kp1 = std::make_tuple(
                B_cols[k+1], R_cols[k+1], pset(k+1), V_cols[k+1], S_cols[k+1], int(useDist), rhoset(k+1));
            
            auto AB = rk4zJacobians(dt0, xk, uk, sat, dyn_k, dyn_kp1);
            Aqk = Gkp1_cached * get<0>(AB) * Gk_cached.t();
            Bqk = Gkp1_cached * get<1>(AB);
        }
        
        // --- Cost Jacobians ---
        cost_jacs costJac;
        vec ek_use = ek;
        if((ek.n_elem == 3) || ((ek.n_elem == 4) && (std::isnan(ek(0))))) {
            ek_use = ek.tail(3);
            costJac = sat.veccostJacobians(k, N, xk, uk, ukp, sat_cols[k], 
                                           ek_use.head(3), Bk, costSettings_tmp);
        } else {
            costJac = sat.quatcostJacobians(k, N, xk, uk, ukp, sat_cols[k], 
                                            ek_use.head(4), Bk, costSettings_tmp);
        }
        
        // --- Constraint Jacobians ---
        auto cnstrJac = sat.constraintJacobians(k, N, uk, xk, sunk);
        cku = get<0>(cnstrJac);
        ckx = get<1>(cnstrJac);
        ck = sat.getConstraints(k, N, uk, xk, sunk);
        Imuk = sat.getImu(mu, mu_cols[k], ck, lam_cols[k]);
        Ilamk = sat.getIlam(mu, mu_cols[k], ck, lam_cols[k]);
        viol = Ilamk * lam_cols[k] + Imuk * ck;
        
        // --- OPTIMIZATION 5: Compute shared intermediate products ---
        PkAqk = Pk * Aqk;              // Used in Qkxx, Qkux
        BqkT_Pk = Bqk.t() * Pk;        // Used in Qkux, Qkuu
        ImukCkx = Imuk * ckx;          // Used in Qkxx, Qkux
        
        // --- Build Q-function matrices using intermediates ---
        Qkxx = costJac.lxx + Aqk.t() * PkAqk + ckx.t() * ImukCkx;
        Qkx = costJac.lx + Aqk.t() * pk + ckx.t() * viol;
        
        // Terminal step handling
        if(k == N-1) {
            pk = Qkx;
            Pk = 0.5 * (Qkxx + Qkxx.t());  // Symmetrize
            continue;
        }
        
        Qkux = costJac.lux + BqkT_Pk * Aqk + cku.t() * ImukCkx;
        Qku = costJac.lu + Bqk.t() * pk + cku.t() * viol;
        Qkuu = costJac.luu + BqkT_Pk * Bqk + cku.t() * Imuk * cku;
        
        // Symmetrize and regularize
        Qkuu = 0.5 * (Qkuu + Qkuu.t());
        Qkuureg = Qkuu + rho_reg * arma::eye(nu, nu);
        
        // --- Cholesky and solve ---
        reset = !arma::chol(Qkuureg_chol, Qkuureg);
        
        if(!reset) {
            // OPTIMIZATION 6: Use triangular solves with pre-computed Cholesky
            // Qkuureg = L * L^T, so solve L * L^T * x = b
            // First: L * y = b (forward substitution)
            // Then: L^T * x = y (backward substitution)
            mat Qkux_solved, Qku_solved;
            Qkux_solved = arma::solve(arma::trimatl(Qkuureg_chol), Qkux);
            Kk = -arma::solve(arma::trimatu(Qkuureg_chol.t()), Qkux_solved);
            
            vec Qku_temp = arma::solve(arma::trimatl(Qkuureg_chol), Qku);
            dk = -arma::solve(arma::trimatu(Qkuureg_chol.t()), Qku_temp);
            
            // Store results
            Kset.slice(k) = Kk;
            dset.col(k) = dk;
            
            // Update P and p for next iteration (k-1)
            // pk = Qkx + K'*Qkuu*d + K'*Qku + Qkux'*d
            pk = Qkx + Kk.t() * (Qkuu * dk + Qku) + Qkux.t() * dk;
            
            // Pk = Qkxx + K'*Qkuu*K + K'*Qkux + Qkux'*K
            Pk = Qkxx + Kk.t() * Qkuu * Kk + Kk.t() * Qkux + Qkux.t() * Kk;
            Pk = 0.5 * (Pk + Pk.t());  // Symmetrize
        } else {
            // Handle regularization increase (existing logic)
            regs = increaseReg(regs, regSettings_tmp);
            rho_reg = get<0>(regs);
            k = N;  // Restart from end
            Pk.zeros();
            pk.zeros();
        }
    }
    
    return std::make_tuple(std::make_tuple(Kset, dset, delV), regs);
}
*/


