{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug C++ Extension",
            "type": "cppdbg",
            "request": "launch",
            // IMPORTANT: Point to the Python interpreter in your venv
            "program": "/home/nic2703/Documents/Generalized_ADCS/venv/bin/python", 
            // IMPORTANT: Point to the Python script running your test
            "args": ["${workspaceFolder}/debug/debug_altro.py"], 
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb", // <--- ADD THIS LINE
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}